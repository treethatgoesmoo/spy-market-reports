[Unit]
Description=Schedule five-minute SPY multi-timeframe market signals

[Timer]
OnCalendar=Mon..Fri *-*-* 10:50/5:00 America/New_York
OnCalendar=Mon..Fri *-*-* 11..15:00/5:00 America/New_York
AccuracySec=15s
Persistent=true
Unit=spy-report-publisher@intraday.service

[Install]
WantedBy=timers.target
